# Copiar a .env.local y llenar. .env* está en .gitignore: nada de esto se versiona.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts locales (importación). NUNCA en el cliente ni en Vercel
# si no hace falta: salta el RLS por completo.
SUPABASE_SERVICE_ROLE_KEY=

# --- El modelo que estima las comidas (solo servidor) ---
# Alcanza con poner UNA de las dos claves: se elige sola.
#
# Gemini tiene capa gratuita (aistudio.google.com/apikey). Para una app
# personal, de unas diez llamadas por día, no se paga nada.
GEMINI_API_KEY=
# Anthropic no tiene capa gratuita, pero fue lo que se midió primero.
ANTHROPIC_API_KEY=

# Solo hace falta si están las dos claves y se quiere forzar una:
# anthropic | gemini
FITFOOD_PROVEEDOR=
# Para probar otro modelo del mismo proveedor sin tocar código.
FITFOOD_MODELO=

# Poner en 1 si la clave de Gemini es de capa paga: hace que los turnos
# cuenten contra el tope mensual en vez de valer cero.
FITFOOD_GEMINI_PAGO=

# Tope de gasto mensual en USD. Al alcanzarlo la app bloquea la IA y deja
# funcionando el registro manual. Ver lib/guardrails.
# En capa gratuita no aplica: ahí el límite es de peticiones, no de dólares.
FITFOOD_TOPE_MENSUAL_USD=10

# --- Solo para el script de importación (npm run import) ---
# Ruta a un clon local del repo de la bitácora.
FITFOOD_REPO_PATH=../fitfood
# Email de la cuenta que recibe los datos importados.
FITFOOD_IMPORT_EMAIL=
